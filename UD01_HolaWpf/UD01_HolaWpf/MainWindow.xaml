<Window x:Class="UD01_HolaWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mi Primera App WPF" Height="300" Width="400"
        MinWidth="300" MinHeight="250"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Fila 0 para la Label -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1 para el TextBox -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 2 para el StackPanel -->
        </Grid.RowDefinitions>

        <!-- Fila 0: etiqueta accesible con mnemónico (Alt+N) -->
        <Label Content="Introduce tu _nombre:" Target="{Binding ElementName=TxtNombre}"
               FontSize="14" Margin="0,0,0,5" Grid.Row="0"/>

        <!-- Fila 1: entrada de texto accesible -->
        <TextBox x:Name="TxtNombre" FontSize="14" Padding="5" Margin="0,0,0,15"
                 Grid.Row="1" TabIndex="1"
                 AutomationProperties.Name="Entrada para el nombre del usuario"
                 AutomationProperties.HelpText="Escriba aquí su nombre de pila para que la aplicación le salude."/>

        <!-- Fila 2: botón + mensaje agrupados correctamente -->
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button x:Name="BtnSaludar" Content="Saludar" Click="BtnSaludar_Click"
                    Padding="15,7" FontSize="14" Cursor="Hand" TabIndex="2" IsDefault="True"
                    AutomationProperties.Name="Botón de saludar"
                    AutomationProperties.HelpText="Al hacer clic o presionar Enter, se mostrará el saludo en pantalla."/>

            <TextBlock x:Name="TxtMensaje" FontSize="14" FontWeight="Bold"
                       Margin="15,0,0,0" VerticalAlignment="Center" Foreground="#FF1976D2"
                       AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
    </Grid>
</Window>
